<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/salatuk_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@android:color/transparent">

    <!-- Mosque Icon on the End / Right side matching Salatuk screenshot -->
    <ImageView
        android:id="@+id/salatuk_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Salatuk Mosque Icon" />

    <!-- Text Information on the Start / Left (RTL Arabic) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/salatuk_icon"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <!-- Line 1: Title (e.g. الهفوف | 25 جمادى الأولى 1448) -->
        <TextView
            android:id="@+id/salatuk_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="الهفوف | 25 جمادى الأولى 1448" />

        <!-- Line 2: Content (Prayer . Time in dark + Timer in bold RED #E53935) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/salatuk_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:text="الظهر . 11:27 " />

            <!-- Guaranteed Vibrant Bold Red Color #E53935 -->
            <TextView
                android:id="@+id/salatuk_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E53935"
                android:text="د + 01:00" />

        </LinearLayout>

        <!-- Line 3: Next Prayer and Time (الصلاة القادمة ووقتها) -->
        <TextView
            android:id="@+id/salatuk_next_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="الصلاة القادمة: العصر . 02:45" />

    </LinearLayout>

</RelativeLayout>
