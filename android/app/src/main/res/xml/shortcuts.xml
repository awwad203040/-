<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_quran"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VOICE_COMMAND"
            android:targetPackage="org.noor.alquran"
            android:targetClass="org.noor.alquran.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="read_quran"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_read_short"
        android:shortcutLongLabel="@string/shortcut_read_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="org.noor.alquran"
            android:targetClass="org.noor.alquran.MainActivity" />
    </shortcut>
</shortcuts>
